{% import '@PrestaShop/Admin/macros.html.twig' as ps %}

{% block drsoft_fr_validate_customer_setting_form %}
    {{ form_start(drsoft_fr_validate_customer_setting_form) }}
    <div class="card">
        <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'drSoft.fr Validate Customer'|trans }}
        </h3>
        <div class="form-wrapper">
            {{ form_errors(drsoft_fr_validate_customer_setting_form) }}
            <div class="align-lg-items-start d-lg-flex">
                <div aria-orientation="vertical"
                     class="border-0 flex-column flex-shrink-0 nav nav-pills"
                     id="v-pills-settings-tab"
                     role="tablist">
                    <button aria-controls="v-pills-settings-2"
                            aria-selected="true"
                            class="active btn nav-link"
                            data-target="#v-pills-settings-2"
                            data-toggle="pill"
                            id="v-pills-setting-2-tab"
                            role="tab"
                            type="button">
                        {{ 'Email'|trans }}
                    </button>
                </div>
                {% block drsoft_fr_validate_customer_setting_form_rest %}
                    <div class="flex-grow-1 tab-content" id="v-pills-settings-tab-content">
                        <div aria-labelledby="v-pills-setting-2-tab"
                             class="tab-pane fade show active"
                             id="v-pills-settings-2"
                             role="tabpanel"
                             tabindex="0">
                            <div class="card m-auto">
                                <fieldset>
                                    <legend>
                                        <h2 class="card-header">{{ 'Email'|trans }}</h2>
                                    </legend>
                                    <div class="card-body">
                                        {{ form_row(drsoft_fr_validate_customer_setting_form.admin_action_customer_account_add_email) }}
                                        {{ form_row(drsoft_fr_validate_customer_setting_form.admin_send_email_on_action_customer_account_add_hook) }}
                                        {{ form_row(drsoft_fr_validate_customer_setting_form.enable_email_approval) }}
                                        {{ form_row(drsoft_fr_validate_customer_setting_form.enable_email_pending_approval) }}
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                    </div>
                {% endblock %}
            </div>
        </div>
        <div class="card-footer">
            <a href="{{ path('admin_drsoft_fr_validate_customer_home_reset') }}"
               class="btn btn-outline-secondary">
                {{ 'Reset default settings'|trans }}
            </a>
            <button class="btn btn-primary float-right">
                {{ 'Save'|trans({}, 'Admin.Actions') }}
            </button>
        </div>
    </div>
    {{ form_end(drsoft_fr_validate_customer_setting_form) }}
{% endblock %}
